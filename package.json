  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/7-Bala/Tocsin/issues"
  },
  "homepage": "https://github.com/7-Bala/Tocsin#readme",
  "devDependencies": {
    "repomix": "^1.18.0"
  }
}
