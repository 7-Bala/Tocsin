# ==============================================================================
# Tocsin Environment Configuration Template
# Copy this file to .env and provide your specific credentials
# ==============================================================================

# Voice Engine (Agora RTC — required for /api/agora/token)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Agora Conversational AI Engine REST API auth (required for /api/agora/start-agent
# and /api/agora/stop-agent; distinct from AGORA_APP_ID/CERTIFICATE above).
# Basic-Auth credentials from the Agora Console — see docs.agora.io RESTful authentication.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# LLM (Google Gemini Live via Agora native MLLM)
GEMINI_API_KEY=

# Optional: public HTTPS URL of the Tocsin MCP tool server (mock-services/server.py)
# for the voice agent to call emergency intelligence tools. Wiring this through Agora's
# Gemini Live "mllm" pipeline is UNVERIFIED against official Agora docs — see
# docs/agora/RESEARCH.md. Treat live in-call tool execution as MOCK/DEMO ONLY until
# verified against a real session. Leave unset to omit MCP wiring entirely.
MCP_SERVER_PUBLIC_URL=

# Telegram Alerts (Optional for live stakeholder broadcasts)
TELEGRAM_BOT_TOKEN=

# Persistence & State
DATABASE_URL=postgresql://tocsin:tocsin_password@localhost:5432/tocsin
REDIS_URL=redis://localhost:6379/0

# Backend Security & Networking
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
TOCSIN_COMMANDER_KEY=

# Local-only fallback; production should use PostgreSQL
USE_SQLITE_FALLBACK=false
SQLITE_DB_PATH=./tocsin_dev.db

# Optional real stakeholder notification
SLACK_WEBHOOK_URL=

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
